  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.3.0",
    "vite": "^5.0.8",
    "vue-tsc": "^1.8.22"
  }
